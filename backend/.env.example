# IRMS Backend — Production Environment
# Copy to .env and fill in real values before deploying.

# PostgreSQL (use Coolify service name "postgres" or container IP)
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=irms
PG_USER=irms
PG_PASSWORD=CHANGE_ME

# Redis (use Coolify service name "redis" or container IP)
REDIS_HOST=redis
REDIS_PORT=6379

# Auth — generate a real secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# Server
PORT=4000
CORS_ORIGIN=*

# Dispatcher invite code
DISPATCHER_CODE=CHANGE_ME

# Media storage
MEDIA_BACKEND=local
MEDIA_MAX_BYTES=10485760

# S3 (only needed if MEDIA_BACKEND=s3)
S3_BUCKET=irms-media
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
